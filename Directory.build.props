<Project>
    <PropertyGroup>
        <Authors>R&amp;D Team</Authors>
        <PackageProjectUrl>https://gitlab.nexcel.vn/RnD/Fanex.RemotingRef/wikis/home</PackageProjectUrl>
        <RepositoryUrl>https://gitlab.nexcel.vn/RnD/Fanex.RemotingRef</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReleaseNotes>Add new method named GetBetBuilderSelectionNames</PackageReleaseNotes>
        <PackageIconUrl>https://gitlab.nexcel.vn/uploads/-/system/project/avatar/100/new-idea.png</PackageIconUrl>
        <DefaultLanguage>en-US</DefaultLanguage>
        <LangVersion>latest</LangVersion>
        <IncludeSymbols>false</IncludeSymbols>
        <Version>1.4.0-beta1</Version>
    </PropertyGroup>
    <PropertyGroup>
        <NoWarn>AD0001</NoWarn>
        <Features>IOperation</Features>
        <CodeAnalysisRuleSet>$(SolutionDir)\SonarQube\RemotingRefCSharp.ruleset</CodeAnalysisRuleSet>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="SonarAnalyzer.CSharp" Version="7.10.0.7896">
            <PrivateAssets>All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="StyleCop.Analyzers" Version="1.1.1-beta.61">
            <PrivateAssets>All</PrivateAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
        <Reference Include="System.Core" Pack="false" />
    </ItemGroup>
</Project>