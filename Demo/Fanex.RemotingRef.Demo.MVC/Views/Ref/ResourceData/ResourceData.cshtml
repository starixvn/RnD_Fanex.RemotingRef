@model Fanex.RemotingRef.Demo.BetTypeName.ResourceDataViewModel
@{
    ViewData["Title"] = "BetTypeName";
}

<h3>Ref Resource Data</h3>
<div class="container-fluid">
    <form class="form-inline row" asp-action="ResourceData">
        <div class="form-group">
            <label asp-for="TypeId" class="control-label">Ref Id</label>
            <input asp-for="TypeId" class="form-control" />
            <span asp-validation-for="TypeId" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="ResourceId" class="control-label"></label>
            <input asp-for="ResourceId" class="form-control" />
            <span asp-validation-for="ResourceId" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Language" class="control-label"></label>
            <input asp-for="Language" class="form-control" />
            <span asp-validation-for="Language" class="text-danger"></span>
        </div>
        <div class="form-group">
            <input class="btn btn-default" type="submit" name="resourceId" value="Submit" />
        </div>
    </form>
    @await Component.InvokeAsync("RefResult", Model)
    <hr />
    <h4>Ref Resource Data List </h4>
    @await Component.InvokeAsync("ResourceDataList")
</div>
