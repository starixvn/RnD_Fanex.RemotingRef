@model Fanex.RemotingRef.Demo.Models.RefDataViewModel

@{
    ViewData["Title"] = Model.DataType;
    var controllerName = Model.DataType.Replace(" ", string.Empty);
}

@using (Html.BeginForm(controllerName, controllerName, FormMethod.Post))
{
    <section id="filter-bar">
        <div class="filter-form">
            <div class="filter-row">
                <div class="lbl-field width-100">
                    @Html.LabelFor(m => m.TypeId, Model.TypeIdLabel)
                </div>
                <div class="edit-field width-120">
                    @Html.TextBoxFor(m => m.TypeId)
                </div>
                <div class="lbl-field width-60">
                    @Html.LabelFor(m => m.Language)
                </div>
                <div class="edit-field width-120">
                    @Html.DropDownListFor(m => m.Language, new SelectList(Model.Languages))
                </div>
                <div class="lbl-field width-60 submit">
                    <input id="submit"  type="submit" name="resourceId" value="Submit" />
                </div>
            </div>
        </div>
    </section>
}
@Html.Partial("~/Views/Ref/_Share/RefResult.cshtml", Model)