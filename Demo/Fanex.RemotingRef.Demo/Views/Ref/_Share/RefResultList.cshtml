@model IEnumerable<Fanex.RemotingRef.Demo.Models.RefDataViewModel>
<br />
<table class="table table-bordered row">
    <thead>
        <tr>
            <td>@Model.First().DataType Id</td>
            <td>Fanex.RemotingRef 4.0</td>
        </tr>
    </thead>
    <tbody>
        @foreach (var viewModel in Model)
        {

        <tr class="@(viewModel.RefDataResult.IsDataMatched()? "text-success" : "text-danger")">
            <td>@viewModel.TypeId</td>
            <td>@viewModel.RefDataResult.FanexRefNew</td>
        </tr>
        }
    </tbody>
</table>