@model Fanex.RemotingRef.Demo.Models.FastMarketChoiceViewModel
@{
    ViewData["Title"] = Model.DataType;
}

<h3>FastMarkets Choice</h3>
<div class="row">
    @using (Html.BeginForm("FastMarketsChoice", "FastMarketsChoice", FormMethod.Post, new { @class = "col-sm-4" }))
    {
        <div class="form-group">
            @Html.LabelFor(m => m.TypeId)
            @Html.TextBoxFor(m => m.TypeId, new { @class = "form-control" })
        </div>
        <div class="form-group">
            @Html.LabelFor(m => m.BetTeam)
            @Html.TextBoxFor(m => m.BetTeam, new { @class = "form-control" })
        </div>
        <div class="form-group">
            @Html.LabelFor(m => m.Handicap1)
            @Html.TextBoxFor(m => m.Handicap1, new { @class = "form-control" })
        </div>
        <div class="form-group">
            @Html.LabelFor(m => m.Handicap2)
            @Html.TextBoxFor(m => m.Handicap2, new { @class = "form-control" })
        </div>
        <div class="form-group">
            @Html.LabelFor(m => m.Language)
            @Html.DropDownListFor(m => m.Language, new SelectList(Model.Languages), new { @class = "form-control" })
        </div>
        <div class="form-group">
            <input class="btn btn-default" type="submit" name="resourceId" value="Submit" />
        </div>
    }
        <div class="col-sm-8">
            @if (Model.IsFirstLoad)
            {
                @Html.Action("FastMarketsChoiceList")
            }
            else
            {
                @Html.Partial("~/Views/Ref/_Share/RefResult.cshtml", Model)
            }
        </div>

</div>
