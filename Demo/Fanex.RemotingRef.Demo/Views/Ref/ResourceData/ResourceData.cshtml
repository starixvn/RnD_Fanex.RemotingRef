@model Fanex.RemotingRef.Demo.Models.ResourceDataViewModel
@{
    ViewData["Title"] = "BetTypeName";
}

<h3>Ref Resource Data</h3>
<div class="row">
    @using (Html.BeginForm("ResourceData", "ResourceData", FormMethod.Post, new { @class = "col-sm-4" }))
    {
        <div class="form-group">
            @Html.LabelFor(m => m.TypeId)
            @Html.TextBoxFor(m => m.TypeId, new { @class = "form-control" })
        </div>
        <div class="form-group">
            @Html.LabelFor(m => m.ResourceId)
            @Html.TextBoxFor(m => m.ResourceId, new { @class = "form-control" })
        </div>
        <div class="form-group">
            @Html.LabelFor(m => m.Language)
            @Html.DropDownListFor(m => m.Language, new SelectList(Model.Languages), new { @class = "form-control" })
        </div>
        <div class="form-group">
            <input class="btn btn-default" type="submit" name="resourceId" value="Submit" />
        </div>
    }
        <div class="col-sm-8">
            @if (Model.IsFirstLoad)
            {
                @Html.Action("ResourceDataList")
            }
            else
            {
                @Html.Partial("~/Views/Ref/_Share/RefResult.cshtml", Model)
            }

        </div>
</div>
