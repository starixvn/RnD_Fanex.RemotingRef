@model Fanex.RemotingRef.Demo.Models.RefDataViewModel

@{
    ViewData["Title"] = "LeagueName";
}

<h3>League Name</h3>

<hr />
<div class="container-fluid">
    <form class="form-inline row" asp-action="LeagueName">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group">
            <label asp-for="TypeId" class="control-label">League Id</label>
            <input asp-for="TypeId" type="number" class="form-control" />
            <span asp-validation-for="TypeId" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Language" class="control-label"></label>
            <input asp-for="Language" class="form-control" />
            <span asp-validation-for="Language" class="text-danger"></span>
        </div>
        <div class="form-group">
            <input type="submit" value="Submit" class="btn btn-default" />
        </div>
    </form>
</div>

@await Component.InvokeAsync("RefResult", Model)
<hr />
<h4>League Name List</h4>
@await Component.InvokeAsync("LeagueNameList")


