@model Fanex.RemotingRef.Demo.Models.BetTypeNameViewModel
@{
    ViewData["Title"] = "Bet Type Name";
}

@using (Html.BeginForm("BetTypeName", "BetTypeName", FormMethod.Post))
{
    <section id="filter-bar">
        <div class="filter-form">
            <div class="filter-row">
                <div class="lbl-field width-80">
                    @Html.LabelFor(m => m.TypeId, "Bet Type Id")
                </div>
                <div class="edit-field width-120">
                    @Html.TextBoxFor(m => m.TypeId)
                </div>
                <div class="lbl-field width-60">
                    @Html.LabelFor(m => m.RefNo, "Ref No")
                </div>
                <div class="edit-field width-120">
                    @Html.TextBoxFor(m => m.RefNo)
                </div>
                <div class="lbl-field width-80">
                    @Html.LabelFor(m => m.ResourceId, "Resource Id")
                </div>
                <div class="edit-field width-120">
                    @Html.TextBoxFor(m => m.ResourceId)
                </div>
                <div class="lbl-field width-60">
                    @Html.LabelFor(m => m.Language)
                </div>
                <div class="edit-field width-120">
                    @Html.DropDownListFor(m => m.Language, new SelectList(Model.Languages))
                </div>
                <div class="lbl-field width-60 submit">
                    <input type="submit" name="resourceId" id="submit" value="Submit" />
                </div>
            </div>
        </div>
    </section>
}

    @Html.Partial("~/Views/Ref/_Share/RefResult.cshtml", Model)