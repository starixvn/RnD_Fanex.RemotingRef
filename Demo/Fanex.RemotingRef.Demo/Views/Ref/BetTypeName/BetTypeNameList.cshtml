@model IEnumerable<Fanex.RemotingRef.Demo.BetTypeName.BetTypeNameViewModel>
<table class="table table-bordered row">
    <thead>
        <tr>
            <td>Bet Type Id</td>
            <td>Taiwan.RemotingRef 1.0</td>
            <td>Taiwan.RemotingRef 2.0</td>
            <td>Fanex.RemotingRef 2.0</td>
        </tr>
    </thead>
    <tbody>
        @foreach (var betTypeViewModel in Model)
        {
            <tr>
                <td>@betTypeViewModel.TypeId</td>
                <td>@betTypeViewModel.RefDataResult.TaiwanRefOld</td>
                <td>@betTypeViewModel.RefDataResult.TaiwanRefNew</td>
                <td>@betTypeViewModel.RefDataResult.FanexRefNew</td>
            </tr>
        }

    </tbody>
</table>



