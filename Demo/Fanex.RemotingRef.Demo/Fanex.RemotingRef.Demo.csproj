    </Reference>
    <Reference Include="NLog.Targets.RabbitMQ">
      <HintPath>Ref\NLog.Targets.RabbitMQ.dll</HintPath>
    </Reference>
    <Reference Include="ONEbook.Common.Caching">
      <HintPath>Ref\ONEbook.Common.Caching.dll</HintPath>
    </Reference>
    <Reference Include="ONEbook.Common.Caching.Redis">
      <HintPath>Ref\ONEbook.Common.Caching.Redis.dll</HintPath>
    </Reference>
    <Reference Include="ONEbook.Common.Caching.RedisLib">
