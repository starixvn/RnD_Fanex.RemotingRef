<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net461</TargetFramework>
    <RuntimeIdentifier>win7-x64</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <WarningsAsErrors>NU1605;</WarningsAsErrors>
    <NoWarn>AD0001;NU1603</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net461|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Setting\RedisSetting.xml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Setting\RedisSetting.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack.AspNetCoreMvcFormatter" Version="1.7.3.2" />
    <PackageReference Include="Microsoft.AspNetCore" Version="2.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc" Version="2.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.0.2" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup>
    <DotNetCliToolReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Tools" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="IBCFile">
      <HintPath>Ref\IBCFile.dll</HintPath>
    </Reference>
    <Reference Include="NLog">
      <HintPath>Ref\NLog.dll</HintPath>
    </Reference>
    <Reference Include="NLog.Targets.RabbitMQ">
      <HintPath>Ref\NLog.Targets.RabbitMQ.dll</HintPath>
    </Reference>
    <Reference Include="ONEbook.Common.Caching">
      <HintPath>Ref\ONEbook.Common.Caching.dll</HintPath>
    </Reference>
    <Reference Include="ONEbook.Common.Caching.Redis">
      <HintPath>Ref\ONEbook.Common.Caching.Redis.dll</HintPath>
    </Reference>
    <Reference Include="ONEbook.Common.Caching.RedisLib">
      <HintPath>Ref\ONEbook.Common.Caching.RedisLib.dll</HintPath>
    </Reference>
    <Reference Include="ONEbook.Common.DataPlus">
      <HintPath>Ref\ONEbook.Common.DataPlus.dll</HintPath>
    </Reference>
    <Reference Include="ONEbook.Product.Site.Common.LocalCache">
      <HintPath>Ref\ONEbook.Product.Site.Common.LocalCache.dll</HintPath>
    </Reference>
    <Reference Include="RefDataModel">
      <HintPath>Ref\RefDataModel.dll</HintPath>
    </Reference>
    <Reference Include="RefNewData">
      <HintPath>Ref\RefNewData.dll</HintPath>
    </Reference>
    <Reference Include="RefRelayRemoteStation">
      <HintPath>Ref\RefRelayRemoteStation.dll</HintPath>
    </Reference>
    <Reference Include="RemotingRef">
      <HintPath>Ref\RemotingRef.dll</HintPath>
    </Reference>
    <Reference Include="SPSRemoting">
      <HintPath>Ref\SPSRemoting.dll</HintPath>
    </Reference>
    <Reference Include="StackExchange.Redis">
      <HintPath>Ref\StackExchange.Redis.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>