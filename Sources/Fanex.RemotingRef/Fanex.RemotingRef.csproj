<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net461;netstandard2.0</TargetFrameworks>
        <Description>RemotignRef client which works with RemotingRef API 2.0.</Description>
        <PackageTags>fanex.remotingref;remotingref</PackageTags>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net461|AnyCPU'">
      <CodeAnalysisRuleSet>Fanex.RemotingRef.ruleset</CodeAnalysisRuleSet>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net461|AnyCPU'">
      <CodeAnalysisRuleSet>Fanex.RemotingRef.ruleset</CodeAnalysisRuleSet>
    </PropertyGroup>
    <ItemGroup>
      <PackageReference Include="MessagePack" Version="1.7.3.1" />
      <PackageReference Include="System.Net.Http" Version="4.3.3" />
    </ItemGroup>
</Project>