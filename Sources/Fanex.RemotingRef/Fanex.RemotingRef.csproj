<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net461;netstandard2.0;net7.0</TargetFrameworks>
    <LangVersion>13.0</LangVersion>
    <Version>1.5.5-beta-01</Version>
    <InfomationalVersion>1.5.5</InfomationalVersion>
    <PackageReleaseNotes>
      - Upgrade MessagePack and System.Net.Http to latest
    </PackageReleaseNotes>
    <PackageTags>fanex.remotingref;remotingref</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
    <PackageReference Include="System.Net.Http" Version="4.3.3" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Net.Http" Version="4.3.3" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MessagePack" Version="2.5.192" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
  </ItemGroup>
</Project>